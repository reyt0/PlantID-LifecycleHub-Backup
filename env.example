# AI 語音/文字記帳解析 (模組一 - 梁偉航)
# 免費金鑰申請: https://aistudio.google.com/apikey
# ⚠️ 這裡只放空白佔位，真的金鑰只填在 .env（已被 .gitignore 排除），
#    絕對不要把真的金鑰寫回這個 .env.example 檔案。
GEMINI_API_KEY=
# 不想用預設的 gemini-3.5-flash-lite 才需要加這一行覆蓋，
# 不用的話直接刪掉這行，不要留空（留空字串會蓋掉程式碼內建的預設值）
# GEMINI_MODEL_NAME=gemini-3.6-flash

# Open-Meteo 免費氣象 API (模組三 - 蘇建豪)
OPEN_METEO_BASE_URL=https://api.open-meteo.com/v1/forecast
DEFAULT_LATITUDE=24.1477
DEFAULT_LONGITUDE=120.6736
WEATHER_CACHE_TTL=7200
